+/*
+ * VWH handoff: binder knows the waker blocks right after a two-way
+ * transaction / reply, so it asks the scheduler to run the wakee on the
+ * waker's CPU (WF_SYNC|WF_CURRENT_CPU).  The scheduler decides whether the
+ * request is admissible; see handoff_admit() in kernel/sched/fair.c.
+ *   bit0 = two-way transaction (caller -> server thread)
+ *   bit1 = reply (server thread -> caller)
+ */
+#define VWH_HANDOFF_TXN		BIT(0)
+#define VWH_HANDOFF_REPLY	BIT(1)
+static unsigned int vwh_handoff __read_mostly;
+
+/*
+ * BCH (block-committed handoff): defer the two-way request wake until the
+ * caller commits to block in binder_wait_for_work(), or until the per-thread
+ * timer expires (defer_window_us).
+ */
+static unsigned int vwh_handoff_defer __read_mostly;
+static unsigned int vwh_defer_window_us __read_mostly = 100;
+static atomic64_t vwh_bch_gen = ATOMIC64_INIT(0);
+static atomic_t vwh_stat_bch_armed = ATOMIC_INIT(0);
+static atomic_t vwh_stat_bch_commit = ATOMIC_INIT(0);
+static atomic_t vwh_stat_bch_expire = ATOMIC_INIT(0);
+static atomic_t vwh_stat_bch_gone = ATOMIC_INIT(0);
+
+static atomic_t vwh_stat_handoff_txn = ATOMIC_INIT(0);
+static atomic_t vwh_stat_handoff_reply = ATOMIC_INIT(0);
+/* wakee resumed on the CPU the handoff targeted / somewhere else */
+static atomic_t vwh_stat_handoff_land = ATOMIC_INIT(0);
+static atomic_t vwh_stat_handoff_miss = ATOMIC_INIT(0);
+/* per-direction landing accounting */
+static atomic_t vwh_stat_handoff_txn_land = ATOMIC_INIT(0);
+static atomic_t vwh_stat_handoff_txn_miss = ATOMIC_INIT(0);
+static atomic_t vwh_stat_handoff_reply_land = ATOMIC_INIT(0);
+static atomic_t vwh_stat_handoff_reply_miss = ATOMIC_INIT(0);
+
+/* VWH handoff admission mask; defined in kernel/sched/fair.c. */
+extern unsigned int handoff_guard;
+/* VWH SIS comparison baseline; defined in kernel/sched/fair.c. */
+extern unsigned int vwh_sis_current;
+extern atomic_t vwh_sis_calls;
+extern atomic_t vwh_sis_hits;
+extern atomic_t vwh_stat_sis_rvh;
+
+/* MUSched-lite baseline: producer-selected capacity-first target CPU. */
+static unsigned int vwh_musched_lite __read_mostly;
+static atomic_t vwh_stat_musched_lite = ATOMIC_INIT(0);
+
 static int proc_show(struct seq_file *m, void *unused);
 DEFINE_SHOW_ATTRIBUTE(proc);
 
@@ -633,6 +686,548 @@ binder_select_thread_ilocked(struct binder_proc *proc)
 	return thread;
 }
 
+/* VWH: wake @thread on this CPU; see vwh_handoff. */
+static void vwh_wake_handoff(struct binder_thread *thread, int dir)
+{
+	WRITE_ONCE(thread->vwh_expect_cpu, raw_smp_processor_id());
+	WRITE_ONCE(thread->vwh_expect_dir, dir);
+	wake_up_interruptible_sync_on_current_cpu(&thread->wait);
+}
+
+/*
+ * BCH: defer the two-way request wake until the caller commits to block in
+ * binder_wait_for_work(), or until the per-thread hrtimer expires.  The
+ * target stays asleep; commit/expiry find it by id on its proc's waiting
+ * list under @proc->inner_lock, so no reference on the target thread is
+ * needed -- a released thread is handled by binder_release_work()
+ * (BR_DEAD_REPLY to the caller).  The caller holds a proc tmp_ref across the
+ * window.
+ */
+static void binder_proc_dec_tmpref(struct binder_proc *proc);
+
+static enum hrtimer_restart vwh_bch_timer_fn(struct hrtimer *timer)
+{
+	struct binder_thread *t = container_of(timer, struct binder_thread,
+					       vwh_bch_timer);
+
+	if (READ_ONCE(t->vwh_bch_defer_active)) {
+		WRITE_ONCE(t->vwh_bch_defer_active, false);
+		atomic_inc(&vwh_stat_bch_expire);
+		wake_up_interruptible(&t->wait);
+	}
+	return HRTIMER_NORESTART;
+}
+
+/* Called with @t->proc->inner_lock held (by binder_wakeup_thread_ilocked). */
+static bool vwh_bch_defer_wake_locked(struct binder_thread *t,
+				      struct binder_thread *from)
+{
+	unsigned int win = READ_ONCE(vwh_defer_window_us);
+	u64 id;
+
+	if (!READ_ONCE(vwh_handoff_defer) || !win || !from)
+		return false;
+	/* one deferral per target; a second wake is delivered immediately */
+	if (!list_empty(&t->waiting_thread_node))
+		return false;
+	/* one outstanding deferral per caller (one tmpref, released once) */
+	if (READ_ONCE(from->vwh_bch_active))
+		return false;
+
+	id = atomic64_inc_return(&vwh_bch_gen);
+	t->proc->tmp_ref++;
+	WRITE_ONCE(from->vwh_bch_tproc, t->proc);
+	WRITE_ONCE(from->vwh_bch_id, id);
+	WRITE_ONCE(from->vwh_bch_active, true);
+	WRITE_ONCE(t->vwh_bch_defer_id, id);
+	WRITE_ONCE(t->vwh_bch_defer_cpu, raw_smp_processor_id());
+	WRITE_ONCE(t->vwh_bch_defer_active, true);
+	list_add(&t->waiting_thread_node, &t->proc->waiting_threads);
+	hrtimer_start(&t->vwh_bch_timer,
+		      ns_to_ktime((u64)win * NSEC_PER_USEC), HRTIMER_MODE_REL);
+	atomic_inc(&vwh_stat_bch_armed);
+	return true;
+}
+
+/* Called from binder_wait_for_work() with no locks held. */
+static void vwh_bch_commit(struct binder_thread *thread)
+{
+	struct binder_proc *tproc = READ_ONCE(thread->vwh_bch_tproc);
+	u64 id = READ_ONCE(thread->vwh_bch_id);
+	struct binder_thread *t;
+	bool found = false;
+
+	if (!READ_ONCE(thread->vwh_bch_active) || !tproc)
+		return;
+
+	WRITE_ONCE(thread->vwh_bch_active, false);
+	WRITE_ONCE(thread->vwh_bch_tproc, NULL);
+
+	binder_inner_proc_lock(tproc);
+	list_for_each_entry(t, &tproc->waiting_threads,
+			    waiting_thread_node) {
+		if (READ_ONCE(t->vwh_bch_defer_active) &&
+		    READ_ONCE(t->vwh_bch_defer_id) == id) {
+			list_del_init(&t->waiting_thread_node);
+			hrtimer_try_to_cancel(&t->vwh_bch_timer);
+			WRITE_ONCE(t->vwh_bch_defer_active, false);
+			WRITE_ONCE(t->vwh_expect_cpu,
+				   raw_smp_processor_id());
+			WRITE_ONCE(t->vwh_expect_dir, VWH_HANDOFF_TXN);
+			wake_up_interruptible_sync_on_current_cpu(&t->wait);
+			atomic_inc(&vwh_stat_bch_commit);
+			found = true;
+			break;
+		}
+	}
+	binder_inner_proc_unlock(tproc);
+	binder_proc_dec_tmpref(tproc);
+	if (!found)
+		atomic_inc(&vwh_stat_bch_gone);
+}
+
+/*
+ * VWH election bookkeeping (modes 4-7): per-caller sticky worker,
+ * per-waiter timestamps and the learned handoff score.  The tuning
+ * parameters are runtime knobs under binder/ctabs/ so policy can be
+ * swept without a rebuild.
+ */
+#define VWH_SCORE_MIN		(-256)
+#define VWH_SCORE_MAX		768
+
+static unsigned int vwh_mode __read_mostly;
+static unsigned int vwh_age_ms __read_mostly = 2;	/* 0 = aging off */
+static unsigned int vwh_score_local __read_mostly = 1024;
+static unsigned int vwh_score_cluster __read_mostly = 512;
+static unsigned int vwh_score_step __read_mostly = 64;
+static unsigned int vwh_score_decay __read_mostly = 4;
+
+/*
+ * VWH election v2 (experimental arms; off by default):
+ *   nodrag     - P arm: no local waiter -> wake the best remote waiter on its
+ *                own CPU (WF_TARGET_CPU) instead of dragging it to the caller.
+ *   elect_rand - O arm: random victim within the elected tier (order-only).
+ *   elect_cost - C arm: lexicographic cost election; a feasible local waiter
+ *                always wins, otherwise rank by cost.  Cost constants are
+ *                arbitrary units until M(src->dst) is measured in ns.
+ */
+static unsigned int vwh_nodrag __read_mostly;
+static unsigned int vwh_elect_rand __read_mostly;
+static unsigned int vwh_elect_cost __read_mostly;
+static unsigned int vwh_elect_load __read_mostly;	/* B-arm: idle-first */
+
+static atomic_t vwh_stat_nodrag_used = ATOMIC_INIT(0);
+static atomic_t vwh_stat_nodrag_ordinary = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elect_rand_used = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elect_cost_used = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elect_cost_local = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elect_cost_any = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elect_load_idle = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elect_load_used = ATOMIC_INIT(0);
+
+#define VWH_COST_MIG_SAME	0
+#define VWH_COST_MIG_CLUSTER	3000
+#define VWH_COST_MIG_FAR	9000
+#define VWH_COST_CONG		500
+#define VWH_COST_STICKY		1000
+#define VWH_COST_AGE_SHIFT	20
+#define VWH_COST_AGE_MAX	256
+#define VWH_COST_CAP_SCALE	4
+
+bool sched_handoff_target_ok(struct task_struct *p, int cpu);
+bool sched_handoff_local_ok(struct task_struct *p, int cpu);
+
+static int vwh_cost_score(struct binder_thread *w, struct binder_thread *caller,
+			  int caller_cpu, int caller_cluster, u64 now)
+{
+	int wcpu = READ_ONCE(w->vwh_last_cpu);
+	unsigned long ccap, wcap;
+	int score = 0;
+	u64 wait;
+
+	if (wcpu < 0)
+		return INT_MAX;
+	if (wcpu == caller_cpu)
+		score += VWH_COST_MIG_SAME;
+	else if (caller_cluster >= 0 &&
+		 topology_cluster_id(wcpu) == caller_cluster)
+		score += VWH_COST_MIG_CLUSTER;
+	else
+		score += VWH_COST_MIG_FAR;
+
+	ccap = arch_scale_cpu_capacity(caller_cpu);
+	wcap = arch_scale_cpu_capacity(wcpu);
+	if (ccap > wcap)
+		score += (int)((ccap - wcap) * VWH_COST_CAP_SCALE);
+
+	/* Prefer a waiter whose own CPU could host it right away. */
+	if (!sched_handoff_target_ok(w->task, wcpu))
+		score += VWH_COST_CONG;
+
+	if (caller && READ_ONCE(caller->vwh_sticky_pid) == w->pid)
+		score -= VWH_COST_STICKY;
+
+	wait = READ_ONCE(w->vwh_wait_ns);
+	if (wait && now > wait)
+		score -= min_t(u64, (now - wait) >> VWH_COST_AGE_SHIFT,
+			       VWH_COST_AGE_MAX);
+
+	return score;
+}
+
+/* Called by a woken thread: did it resume where the handoff targeted? */
+static void vwh_note_landing(struct binder_thread *thread)
+{
+	int exp = READ_ONCE(thread->vwh_expect_cpu);
+	int dir = READ_ONCE(thread->vwh_expect_dir);
+	bool landed;
+
+	if (exp < 0)
+		return;
+	WRITE_ONCE(thread->vwh_expect_cpu, -1);
+	WRITE_ONCE(thread->vwh_expect_dir, 0);
+	landed = raw_smp_processor_id() == exp;
+	if (landed) {
+		atomic_inc(&vwh_stat_handoff_land);
+		if (dir == VWH_HANDOFF_REPLY)
+			atomic_inc(&vwh_stat_handoff_reply_land);
+		else
+			atomic_inc(&vwh_stat_handoff_txn_land);
+	} else {
+		atomic_inc(&vwh_stat_handoff_miss);
+		if (dir == VWH_HANDOFF_REPLY)
+			atomic_inc(&vwh_stat_handoff_reply_miss);
+		else
+			atomic_inc(&vwh_stat_handoff_txn_miss);
+	}
+
+	/* mode 7: score the wakee on the handoff outcome. */
+	if (READ_ONCE(vwh_mode) >= 7) {
+		unsigned int decay = min_t(unsigned int,
+					   READ_ONCE(vwh_score_decay), 16);
+		int step = READ_ONCE(vwh_score_step);
+		int score = READ_ONCE(thread->vwh_score);
+
+		/* arithmetic shift on a negative score is not portable */
+		score -= (score >= 0) ? (score >> decay)
+				      : -((-score) >> decay);
+		score += landed ? step : -step;
+		score = clamp(score, VWH_SCORE_MIN, VWH_SCORE_MAX);
+		WRITE_ONCE(thread->vwh_score, score);
+	}
+}
+
+/*
+ * VWH election: 0 keeps the stock FIFO pick; 2 prefers the waiting thread
+ * whose last CPU is the waker's CPU (a cache-warm worker) for synchronous
+ * transactions; 3 adds a same-cluster fallback before FIFO; 4 tries the
+ * caller's sticky worker first; 5 picks the most recently served local
+ * waiter; 6 adds an aging guard so a waiter past VWH_AGE_NS wins; 7 ranks
+ * candidates with a learned score on top of topology and age.
+ * The elected thread is removed from the waiting list like the stock
+ * selector does, so wakeup ownership is unchanged.
+ */
+static atomic_t vwh_stat_elected = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elected_cluster = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elected_sticky = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elected_age = ATOMIC_INIT(0);
+static atomic_t vwh_stat_elect_fallback = ATOMIC_INIT(0);
+
+static struct binder_thread *vwh_take_thread(struct binder_thread *thread)
+{
+	list_del_init(&thread->waiting_thread_node);
+	WRITE_ONCE(thread->vwh_served_ns, ktime_get_ns());
+	return thread;
+}
+
+static struct binder_thread *vwh_elect_thread(struct binder_proc *proc,
+					      struct binder_thread *caller,
+					      int *wake_target)
+{
+	struct binder_thread *thread, *best = NULL;
+	int caller_cpu = raw_smp_processor_id();
+	int caller_cluster;
+	u64 now = ktime_get_ns();
+
+	*wake_target = -1;
+
+	if (vwh_mode < 2 || vwh_mode > 7)
+		return NULL;
+
+	caller_cluster = topology_cluster_id(caller_cpu);
+
+	/*
+	 * Cost-election arm (C): lexicographic -- a feasible local waiter
+	 * always wins; otherwise rank the remaining waiters by cost.
+	 */
+	if (READ_ONCE(vwh_elect_cost)) {
+		struct binder_thread *local = NULL, *any = NULL;
+		int local_score = INT_MAX, any_score = INT_MAX;
+		u64 local_wait = U64_MAX, any_wait = U64_MAX;
+
+		list_for_each_entry(thread, &proc->waiting_threads,
+				    waiting_thread_node) {
+			int wcpu = READ_ONCE(thread->vwh_last_cpu);
+			u64 wait;
+			int score;
+
+			if (wcpu < 0)
+				continue;
+			score = vwh_cost_score(thread, caller, caller_cpu,
+					       caller_cluster, now);
+			wait = READ_ONCE(thread->vwh_wait_ns);
+			if (wcpu == caller_cpu &&
+			    sched_handoff_local_ok(thread->task, caller_cpu) &&
+			    (score < local_score ||
+			     (score == local_score && wait && wait < local_wait))) {
+				local_score = score;
+				local_wait = wait;
+				local = thread;
+			}
+			if (score < any_score ||
+			    (score == any_score && wait && wait < any_wait)) {
+				any_score = score;
+				any_wait = wait;
+				any = thread;
+			}
+		}
+		if (local) {
+			atomic_inc(&vwh_stat_elect_cost_local);
+			atomic_inc(&vwh_stat_elect_cost_used);
+			best = vwh_take_thread(local);
+			goto out;
+		}
+		if (any) {
+			int wcpu = READ_ONCE(any->vwh_last_cpu);
+
+			atomic_inc(&vwh_stat_elect_cost_any);
+			atomic_inc(&vwh_stat_elect_cost_used);
+			best = vwh_take_thread(any);
+			if (READ_ONCE(vwh_nodrag) && wcpu >= 0 &&
+			    wcpu != caller_cpu &&
+			    sched_handoff_target_ok(any->task, wcpu)) {
+				*wake_target = wcpu;
+				atomic_inc(&vwh_stat_nodrag_used);
+			}
+			goto out;
+		}
+		goto fallback;
+	}
+
+	/* modes 4-7: the caller's own sticky worker comes first. */
+	if (vwh_mode >= 4 && caller && READ_ONCE(caller->vwh_sticky_pid)) {
+		list_for_each_entry(thread, &proc->waiting_threads,
+				    waiting_thread_node) {
+			if (thread->pid == READ_ONCE(caller->vwh_sticky_pid) &&
+			    READ_ONCE(thread->vwh_last_cpu) == caller_cpu) {
+				atomic_inc(&vwh_stat_elected_sticky);
+				best = vwh_take_thread(thread);
+				goto out;
+			}
+		}
+	}
+
+	/* modes 6-7: a waiter past VWH_AGE_NS wins outright (LAS guard). */
+	if (vwh_mode >= 6) {
+		u64 age_ns = (u64)READ_ONCE(vwh_age_ms) * NSEC_PER_MSEC;
+		u64 oldest = now;
+
+		list_for_each_entry(thread, &proc->waiting_threads,
+				    waiting_thread_node) {
+			u64 wait = READ_ONCE(thread->vwh_wait_ns);
+
+			if (wait && wait < oldest) {
+				oldest = wait;
+				best = thread;
+			}
+		}
+		if (age_ns && best && now - oldest > age_ns) {
+			atomic_inc(&vwh_stat_elected_age);
+			best = vwh_take_thread(best);
+			goto out;
+		}
+		best = NULL;
+	}
+
+	/* mode 7: rank candidates by topology + learned score + age. */
+	if (vwh_mode >= 7) {
+		int best_score = INT_MIN;
+
+		list_for_each_entry(thread, &proc->waiting_threads,
+				    waiting_thread_node) {
+			int wcpu = READ_ONCE(thread->vwh_last_cpu);
+			int score = READ_ONCE(thread->vwh_score);
+			u64 wait = READ_ONCE(thread->vwh_wait_ns);
+
+			if (wcpu == caller_cpu)
+				score += READ_ONCE(vwh_score_local);
+			else if (caller_cluster >= 0 && wcpu >= 0 &&
+				 topology_cluster_id(wcpu) == caller_cluster)
+				score += READ_ONCE(vwh_score_cluster);
+			if (wait)
+				score += min_t(u64, (now - wait) >> 20, 256);
+			if (score > best_score) {
+				best_score = score;
+				best = thread;
+			}
+		}
+		if (best) {
+			atomic_inc(&vwh_stat_elected);
+			best = vwh_take_thread(best);
+			goto out;
+		}
+	}
+
+	/* load-aware (B-arm): prefer a waiter whose CPU is currently idle */
+	if (READ_ONCE(vwh_elect_load)) {
+		struct binder_thread *idle_any = NULL, *idle_near = NULL;
+		unsigned int ni = 0;
+
+		list_for_each_entry(thread, &proc->waiting_threads,
+				    waiting_thread_node) {
+			int wcpu = READ_ONCE(thread->vwh_last_cpu);
+
+			if (wcpu < 0 || !available_idle_cpu(wcpu))
+				continue;
+			if (READ_ONCE(vwh_elect_rand)) {
+				if (get_random_u32_below(++ni) == 0)
+					idle_any = thread;
+				continue;
+			}
+			if (!idle_any)
+				idle_any = thread;
+			if (!idle_near && caller_cluster >= 0 &&
+			    topology_cluster_id(wcpu) == caller_cluster)
+				idle_near = thread;
+		}
+		if (idle_near || idle_any) {
+			atomic_inc(&vwh_stat_elect_load_idle);
+			atomic_inc(&vwh_stat_elect_load_used);
+			return vwh_take_thread(idle_near ? idle_near : idle_any);
+		}
+		/* no idle waiter -> fall through to same-CPU */
+	}
+
+	/* modes 2-6: same CPU (MRU from mode 5), then same cluster. */
+	if (vwh_mode <= 6) {
+		u64 best_served = 0;
+		unsigned int n = 0;
+
+		list_for_each_entry(thread, &proc->waiting_threads,
+				    waiting_thread_node) {
+			u64 served;
+			int wcpu = READ_ONCE(thread->vwh_last_cpu);
+
+			if (wcpu != caller_cpu)
+				continue;
+			if (READ_ONCE(vwh_elect_rand)) {
+				if (get_random_u32_below(++n) == 0)
+					best = thread;
+				continue;
+			}
+			served = READ_ONCE(thread->vwh_served_ns);
+			if (vwh_mode >= 5) {
+				if (!best || served > best_served) {
+					best = thread;
+					best_served = served;
+				}
+			} else {
+				best = thread;
+				break;
+			}
+		}
+		if (best && READ_ONCE(vwh_elect_rand)) {
+			atomic_inc(&vwh_stat_elected);
+			atomic_inc(&vwh_stat_elect_rand_used);
+			if (READ_ONCE(vwh_elect_load))
+				atomic_inc(&vwh_stat_elect_load_used);
+			best = vwh_take_thread(best);
+			goto out;
+		}
+		if (best) {
+			atomic_inc(&vwh_stat_elected);
+			if (READ_ONCE(vwh_elect_load))
+				atomic_inc(&vwh_stat_elect_load_used);
+			best = vwh_take_thread(best);
+			goto out;
+		}
+
+		if (vwh_mode >= 3 && caller_cluster >= 0) {
+			n = 0;
+			list_for_each_entry(thread, &proc->waiting_threads,
+					    waiting_thread_node) {
+				int wcpu = READ_ONCE(thread->vwh_last_cpu);
+
+				if (wcpu < 0 ||
